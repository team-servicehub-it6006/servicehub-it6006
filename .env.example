# Copy to .env and fill in. Never commit the real file.
# A missing DJANGO_SECRET_KEY with DEBUG off stops the app starting, on purpose.

DJANGO_SECRET_KEY=generate-your-own-50-character-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave unset to use the local SQLite file.
# DATABASE_URL=postgres://user:password@localhost:5432/servicehub

# Only needed once DEBUG is off. In development mail is printed to the console.
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=no-reply@servicehub.co.nz
